PAYPRO_VENDOR_ID=             # From Account Settings → Business Info (for REST API)
PAYPRO_SANDBOX=true
PAYPRO_PRODUCT_PRO_MONTHLY=   # PayPro product ID integer
PAYPRO_PRODUCT_PRO_YEARLY=    # PayPro product ID integer

# Admin API (for publishing domain report pages, internal use only)
ADMIN_SECRET=
